# Reference for local environment variables. Never commit real credentials.

# X / Twitter: OAuth 2.0 user access token with tweet.write permission.
X_USER_ACCESS_TOKEN=

# Meta Graph API version, for example the version currently enabled for your app.
META_GRAPH_API_VERSION=

# Facebook page
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram professional account connected to the same Meta app.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Pinterest API v5; the board must belong to the authorized account.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Set true only after all selected account credentials and permissions are verified.
AUTO_PUBLISH=false
